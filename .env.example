# Copy this to .env and fill in your values.
# .env is gitignored — never commit real tokens.

# Your Sleeper username (required)
SLEEPER_USERNAME=your_sleeper_username

# Your league ID — if omitted, the most recent league is auto-selected
# Find it in the URL: sleeper.com/leagues/<LEAGUE_ID>/team
SLEEPER_LEAGUE_ID=

# JWT token from your Sleeper session — only needed for write operations (lineup, waivers, trades)
# To get it: open Sleeper in Chrome → DevTools → Console → paste:
#   localStorage.getItem('token')
# Tokens last ~1 year. Leave blank for read-only mode.
SLEEPER_TOKEN=
